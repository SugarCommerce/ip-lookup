{
    "name": "sugarcommerce/ip-lookup",
    "description": "Ask AbuseIPDB, IPinfo, IPQualityScore, ProxyCheck or MaxMind minFraud about an IP address from WordPress and get one answer whichever you use: risk, proxy, VPN, Tor, hosting, country and network, cached, with failures remembered, and conditions a shop owner can build rules on.",
    "homepage": "https://github.com/SugarCommerce/ip-lookup",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "David Sherlock",
            "homepage": "https://arraypress.com/"
        }
    ],
    "keywords": [
        "wordpress",
        "ip",
        "fraud",
        "proxy",
        "vpn",
        "abuseipdb",
        "ipinfo",
        "ipqualityscore",
        "proxycheck",
        "minfraud"
    ],
    "require": {
        "php": ">=8.3",
        "sugarcommerce/geo": "dev-main",
        "sugarcommerce/network": "dev-main"
    },
    "require-dev": {
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "phpunit/phpunit": "^12.0",
        "squizlabs/php_codesniffer": "^3.13.5",
        "sugarcommerce/conditions": "dev-main",
        "wp-coding-standards/wpcs": "^3.4"
    },
    "suggest": {
        "sugarcommerce/conditions": "Offers each service's answers as conditions in a rule builder."
    },
    "repositories": [
        {
            "type": "path",
            "url": "../geo",
            "options": {
                "symlink": false
            }
        },
        {
            "type": "path",
            "url": "../network",
            "options": {
                "symlink": false
            }
        },
        {
            "type": "path",
            "url": "../conditions",
            "options": {
                "symlink": false
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "SugarCommerce\\IpLookup\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SugarCommerce\\IpLookup\\Tests\\": "tests/"
        },
        "exclude-from-classmap": [
            "/tests/bootstrap.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "preferred-install": "dist",
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "phpunit",
        "lint": "phpcs",
        "format": "phpcbf --standard=phpcs-format.xml.dist",
        "format:check": "phpcs --standard=phpcs-format.xml.dist"
    },
    "support": {
        "issues": "https://github.com/SugarCommerce/ip-lookup/issues",
        "source": "https://github.com/SugarCommerce/ip-lookup"
    }
}
